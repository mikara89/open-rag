# OpenRAG EditorConfig
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
indent_size = 4

# C# code style
[*.cs]
# Prefer var (matches existing codebase)
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_method_group_conversion = true:silent

# Organize usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Braces and newlines
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false

# Nullable
dotnet_diagnostic.CS8618.severity = warning

# XML doc comments (not required)
dotnet_diagnostic.CS1591.severity = none

# Analyzer severity tuning — keep codebase manageable
# Performance suggestions (opt-in later)
dotnet_diagnostic.CA1848.severity = suggestion   # LoggerMessage delegates
dotnet_diagnostic.CA1873.severity = suggestion   # Logger delegates (future)
dotnet_diagnostic.CA1861.severity = suggestion   # Avoid constant arrays
dotnet_diagnostic.CA1859.severity = suggestion   # Use concrete types
dotnet_diagnostic.CA1822.severity = suggestion   # Mark members static
dotnet_diagnostic.CA1826.severity = suggestion   # Use property instead of Enumerable
# Correctness/safety — keep as warnings
dotnet_diagnostic.CA2016.severity = warning      # Forward CancellationToken
dotnet_diagnostic.CA2012.severity = warning      # ValueTask usage

[*.{json,xml,yml,yaml,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Test projects — suppress naming rules for xunit conventions
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# Generated EF Core migration files — exempt from namespace style
[**/Migrations/*.cs]
csharp_style_namespace_declarations = block_scoped:none
generated_code = true
