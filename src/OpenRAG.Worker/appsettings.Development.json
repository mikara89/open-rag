{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "openrag-db": "Host=localhost;Port=5432;Database=openrag;Username=openrag;Password=openrag",
    "rabbitmq": "amqp://guest:guest@localhost:5672/"
  },
  "Storage": {
    "LocalRootPath": ".openrag-storage"
  },
  "Chunking": {
    "Provider": "DoclingJson",
    "MaxChunkCharacters": 2000,
    "OverlapCharacters": 200,
    "UseDoclingJsonWhenAvailable": true
  },
  "AI": {
    "Embeddings": {
      "Provider": "Mock",
      "BaseUrl": "http://localhost:1234/v1",
      "ApiKey": "lm-studio",
      "Model": "nomic-embed-text",
      "EmbeddingVersion": "v1",
      "TimeoutSeconds": 120
    },
    "Chat": {
      "Provider": "OpenAICompatible",
      "BaseUrl": "https://api.deepseek.com/v1",
      "ApiKey": "YOUR_DEEPSEEK_API_KEY_HERE",
      "Model": "deepseek-chat",
      "TimeoutSeconds": 120,
      "Temperature": 0.2,
      "MaxTokens": 1024
    }
  },
  "Preprocessing": {
    "Docling": {
      "Provider": "DoclingServe",
      "BaseUrl": "http://localhost:33523",
      "ConvertFilePath": "/v1/convert/file",
      "TimeoutSeconds": 300,
      "IncludeMarkdown": true,
      "IncludeJson": true,
      "EnableOcr": false
    }
  }
}